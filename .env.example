# SingRayPanel 部署配置模板
# 用法: cp .env.example .env  然后填好两个密钥
#
# 说明: 本文件只被"部署方式"读取(systemd 的 EnvironmentFile 或 docker compose 的
# env_file), 应用本身不加载 .env(没有 dotenv 依赖)。本地开发请直接 export。

# ---------------------------------------------------------------- 监听
# 容器内必须 0.0.0.0, 否则同网络的 nginx 连不进来;裸机 + nginx 反代同理。
# 只有"仅本机调试"才用 127.0.0.1。
PANEL_HOST=0.0.0.0
PANEL_PORT=3000

# ---------------------------------------------------------------- 密钥(必填)
# 两条都必须填, 且互不相同。生成: openssl rand -hex 32
# 留空或沿用模板占位值, 在 PANEL_HOST 非 127.0.0.1 时会被拒绝启动。
PANEL_JWT_SECRET=
# 字段加密密钥:节点凭据 / SSH 私钥都以它加密落库。
# 从旧面板迁移时必须填旧面板的 APP_SECRET, 否则历史密文全部解不开。
PANEL_APP_SECRET=

# ---------------------------------------------------------------- 初始管理员
# 仅在数据库为空、首次启动时生效;建库后再改这里无效, 请走界面改密码。
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=admin888

# ---------------------------------------------------------------- 存储
# 裸机相对路径基于 apps/server 解析;Docker 下由 compose 固定为 /app/data/panel.db
PANEL_DB=./data/panel.db
# 留空 = db 同目录的 backups/
PANEL_BACKUP_DIR=
PANEL_BACKUP_RETENTION=14
# 每日备份小时(0-23), 按进程本地时间判断, 配合 TZ 使用
PANEL_BACKUP_HOUR=4

# ---------------------------------------------------------------- 运维
# 健康检查间隔(分钟), 会对所有机器并发 SSH 探活
PANEL_HEALTH_INTERVAL=5
# 时区:影响备份小时与日志时间戳
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 证书
# Cloudflare API Token。配置后 ACME 走 DNS-01(无需 80 端口),
# 不配则回退 HTTP-01(要求目标机 80 可达)。acme.sh 在目标机上执行, 与面板无关。
PANEL_CF_TOKEN=

# ---------------------------------------------------------------- 告警(可选)
# 不填则告警只落库、不推送。
# 注意: 容器内直连 api.telegram.org, Node 的 fetch 不认 HTTPS_PROXY。
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---------------------------------------------------------------- 核心安装源
# 留空走官方 GitHub;国内机器可指向 gh-proxy 镜像前缀。
SINGBOX_DOWNLOAD_BASE=
SINGBOX_VERSION=latest
XRAY_DOWNLOAD_BASE=
XRAY_VERSION=latest

# ================================================================ Docker 专用
# 以下只被 docker-compose.yml 读取, 裸机部署可忽略。

# 宿主机暴露端口(nginx 入口)
PANEL_HTTP_PORT=8080

# 镜像来源。默认对应 GitHub Actions 推送到 GHCR 的产物;
# 私有包需先 docker login ghcr.io。也可改成自建 registry 或本地 tag。
PANEL_SERVER_IMAGE=ghcr.io/woliubang256/singray-panel-server
PANEL_WEB_IMAGE=ghcr.io/woliubang256/singray-panel-web
# 镜像 tag: latest / main / sha-abc1234 / v1.2.3
PANEL_TAG=latest

# 数据落盘位置。留空 = 命名卷 panel-data(推荐, WAL 更安全);
# 填绝对路径 = bind mount 到该目录, 例如 /opt/singray/data
PANEL_DATA_DIR=

# 重启策略与停机宽限
PANEL_RESTART_POLICY=unless-stopped
PANEL_STOP_GRACE=20s
