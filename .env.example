# SingRayPanel 部署配置模板
# 用法: cp .env.example .env  然后填好两个密钥
#
# 应用自动加载仓库根目录 .env;已有环境变量优先(systemd / docker compose 不会被覆盖)。
# 可用 PANEL_ENV_FILE 指定其他路径。

# ---------------------------------------------------------------- 监听
# 容器内必须 0.0.0.0, 否则同网络的 nginx 连不进来。
# 裸机 + nginx 同机反代或仅本机开发时可改成 127.0.0.1。
PANEL_HOST=0.0.0.0
PANEL_PORT=3000
# nginx/caddy 反代部署时改成 1,按真实客户端 IP 限流;直连部署保持 0。
PANEL_TRUST_PROXY=0

# ---------------------------------------------------------------- 密钥(必填)
# 两条都必须填, 且互不相同。生成: openssl rand -hex 32
# 留空或沿用模板占位值都会被拒绝启动,与 PANEL_HOST 无关。
PANEL_JWT_SECRET=
# 字段加密密钥:节点凭据 / SSH 私钥都以它加密落库。
# 从旧面板迁移时必须填旧面板的 APP_SECRET, 否则历史密文全部解不开。
PANEL_APP_SECRET=

# ---------------------------------------------------------------- 初始管理员
# 仅在数据库为空、首次启动时生效;建库后再改这里无效, 请走界面改密码。
# 口令留空 = 随机生成 16 位并只打印一次(首次启动日志里查看)。
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=

# ---------------------------------------------------------------- 存储
# 裸机相对路径基于 apps/server 解析;Docker 下由 compose 固定为 /app/data/panel.db
PANEL_DB=./data/panel.db
# 留空 = db 同目录的 backups/
PANEL_BACKUP_DIR=
PANEL_BACKUP_RETENTION=14
# 每日备份小时(0-23), 按进程本地时间判断, 配合 TZ 使用
PANEL_BACKUP_HOUR=4

# ---------------------------------------------------------------- 运维
# 健康检查间隔(分钟), 会对所有机器并发 SSH 探活
PANEL_HEALTH_INTERVAL=5
# 节点可用性自动探测间隔(分钟),从面板连接节点实际入口;0 = 关闭
PANEL_PROBE_INTERVAL=30
# 时区:影响备份小时与日志时间戳
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 证书
# Cloudflare API Token。配置后 ACME 走 DNS-01(无需 80 端口),
# 不配则回退 HTTP-01(要求目标机 80 可达)。acme.sh 在目标机上执行, 与面板无关。
PANEL_CF_TOKEN=

# ---------------------------------------------------------------- 告警(可选)
# 不填则告警只落库、不推送。
# 注意: 容器内直连 api.telegram.org, Node 的 fetch 不认 HTTPS_PROXY。
# 面板设置中保存的 Cloudflare / Telegram Token 加密落库,更换 APP_SECRET 后需重新录入。
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---------------------------------------------------------------- 核心安装源
# 面板只负责 SSH 到目标机执行 curl, 下载动作发生在被管机器上。
# 留空 = 官方 GitHub(SagerNet/sing-box、XTLS/Xray-core 的 releases/download)。
# 直连失败会自动回退 gh-proxy.org 镜像, 一般不需要动这两项。
# 若要强制走镜像,必须填完整前缀且带 http(s)://, 结尾不要加斜杠, 例如:
#   SINGBOX_DOWNLOAD_BASE=https://gh-proxy.org/https://github.com/SagerNet/sing-box/releases/download
SINGBOX_DOWNLOAD_BASE=
# 默认固定版本;只有显式写 latest 才查询 GitHub 最新版本。升级失败可用「管理 → 回退版本」。
SINGBOX_VERSION=1.13.18
XRAY_DOWNLOAD_BASE=
XRAY_VERSION=24.11.30

# ================================================================ Docker 专用
# 以下只被 docker-compose.yml / docker-compose.local.yml 读取, 裸机部署可忽略。

# 宿主机暴露端口(nginx 入口)
PANEL_HTTP_PORT=8080

# 镜像来源。默认对应 GitHub Actions 推送到 GHCR 的产物;
# 私有包需先 docker login ghcr.io。也可改成自建 registry 或本地 tag。
PANEL_SERVER_IMAGE=ghcr.io/woliubang256/singray-panel-server
PANEL_WEB_IMAGE=ghcr.io/woliubang256/singray-panel-web
# 镜像 tag: latest / main / sha-abc1234 / v1.2.3
PANEL_TAG=latest

# 数据落盘位置:
#   留空              → 命名卷 panel-data(推荐,WAL 不必跨文件系统)
#   绝对路径          → bind mount, 例如 /opt/singray/data
#   相对路径 ./data   → 也可以, 相对于 compose 文件所在目录
# 注意:bind mount 的宿主目录若由 Docker 自动创建,属主是 root;容器入口脚本会 chown 修正。
# 挂在 NFS 等禁止 chown 的存储上时,需先在宿主侧 chown -R 1000:1000。
PANEL_DATA_DIR=

# 重启策略与停机宽限
PANEL_RESTART_POLICY=unless-stopped
PANEL_STOP_GRACE=20s
